{%- comment -%}
  The payment methods enabled on this shop, drawn from Shopify.
{%- endcomment -%}
{%- if shop.enabled_payment_types.size > 0 -%}
  <ul class="payment-icons" aria-label="{{ 'sections.footer.payment_methods' | t }}">
    {%- for type in shop.enabled_payment_types -%}
      <li class="payment-icons__item">
        {{ type | payment_type_svg_tag: class: 'payment-icons__icon' }}
      </li>
    {%- endfor -%}
  </ul>
{%- endif -%}
