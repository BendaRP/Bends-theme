{%- comment -%}
  Blog article card.

  Accepts:
  - article:      {Article}
  - index:        {Number}
  - show_excerpt: {Boolean}
  - sizes:        {String}
{%- endcomment -%}
{%- liquid
  assign card_sizes = sizes | default: '(min-width: 990px) 33vw, 90vw'
  assign card_index = index | default: 0
-%}
<article class="article-card" data-reveal style="--reveal-delay: calc(var(--stagger) * {{ card_index }});">
  <a class="article-card__link" href="{{ article.url }}">
    <div class="frame" data-ratio="landscape">
      {%- if article.image -%}
        {%- render 'responsive-image',
          image: article.image,
          sizes: card_sizes,
          class: 'article-card__image'
        -%}
      {%- else -%}
        <div class="media-placeholder">{{ 'image' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>

    <div class="article-card__body">
      {%- if article.tags.size > 0 -%}
        <span class="eyebrow">{{ article.tags.first }}</span>
      {%- endif -%}
      <h3 class="article-card__title h5">{{ article.title }}</h3>
      {%- if show_excerpt and article.excerpt_or_content != blank -%}
        <p class="text-small text-muted">{{ article.excerpt_or_content | strip_html | truncate: 130 }}</p>
      {%- endif -%}
      <span class="article-card__meta text-tiny text-muted">
        {{- article.published_at | date: format: 'date' -}}
      </span>
    </div>
  </a>
</article>
