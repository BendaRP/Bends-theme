{%- comment -%}
  One line in the cart, used by both the drawer and the cart page.

  Accepts:
  - item:  {LineItem}
  - index: {Number} the line number, needed by the cart change API
{%- endcomment -%}
{%- liquid
  assign line_saving = 0
  if item.variant.compare_at_price > item.variant.price
    assign line_saving = item.variant.compare_at_price | minus: item.variant.price | times: item.quantity
  endif
-%}
<li class="cart-item" data-cart-item data-line="{{ index }}" data-key="{{ item.key }}">
  <a class="cart-item__media" href="{{ item.url }}" tabindex="-1" aria-hidden="true">
    <div class="frame frame--soft" data-ratio="square">
      {%- if item.image -%}
        {%- render 'responsive-image',
          image: item.image,
          widths: '100,150,200,300',
          sizes: '100px',
          max_width: 300,
          alt: item.title
        -%}
      {%- else -%}
        <div class="media-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>
  </a>

  <div class="cart-item__details">
    <a class="cart-item__title" href="{{ item.url }}">{{ item.product.title }}</a>

    {%- unless item.product.has_only_default_variant -%}
      <p class="cart-item__variant text-tiny text-muted">
        {%- for option in item.options_with_values -%}
          {{ option.name }}: {{ option.value }}{% unless forloop.last %} · {% endunless %}
        {%- endfor -%}
      </p>
    {%- endunless -%}

    {%- if item.selling_plan_allocation -%}
      <p class="cart-item__plan text-tiny text-muted">{{ item.selling_plan_allocation.selling_plan.name }}</p>
    {%- endif -%}

    {%- assign property_size = item.properties | size -%}
    {%- if property_size > 0 -%}
      <ul class="cart-item__properties text-tiny text-muted">
        {%- for property in item.properties -%}
          {%- assign first_character = property.first | slice: 0 -%}
          {%- if property.last != blank and first_character != '_' -%}
            <li>
              {{ property.first }}:
              {%- if property.last contains '/uploads/' -%}
                <a class="link" href="{{ property.last }}" target="_blank" rel="noopener">{{ property.last | split: '/' | last }}</a>
              {%- else -%}
                {{ property.last }}
              {%- endif -%}
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>
    {%- endif -%}

    {%- if item.line_level_discount_allocations.size > 0 -%}
      <ul class="cart-item__discounts text-tiny">
        {%- for allocation in item.line_level_discount_allocations -%}
          <li class="text-success">
            {% render 'icon', icon: 'tag' %}
            {{ allocation.discount_application.title }} (−{{ allocation.amount | money }})
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="cart-item__controls">
      <quantity-input class="quantity" data-line="{{ index }}">
        <button
          class="quantity__button tap-target"
          type="button"
          name="minus"
          aria-label="{{ 'accessibility.decrease_quantity' | t }}"
        >
          {% render 'icon', icon: 'minus' %}
        </button>
        <label class="visually-hidden" for="cart-quantity-{{ index }}">
          {{- 'accessibility.quantity_for' | t: title: item.product.title -}}
        </label>
        <input
          id="cart-quantity-{{ index }}"
          class="quantity__input"
          type="number"
          name="updates[]"
          value="{{ item.quantity }}"
          min="0"
          step="1"
          inputmode="numeric"
          data-quantity-input
        >
        <button
          class="quantity__button tap-target"
          type="button"
          name="plus"
          aria-label="{{ 'accessibility.increase_quantity' | t }}"
        >
          {% render 'icon', icon: 'plus' %}
        </button>
      </quantity-input>

      <button
        class="cart-item__remove tap-target"
        type="button"
        data-cart-remove
        data-line="{{ index }}"
        aria-label="{{ 'accessibility.remove_item' | t: title: item.product.title }}"
      >
        {% render 'icon', icon: 'trash' %}
      </button>
    </div>
  </div>

  <div class="cart-item__pricing">
    <span class="cart-item__price">{{ item.final_line_price | money }}</span>
    {%- if settings.cart_show_compare_price and item.variant.compare_at_price > item.variant.price -%}
      {%- assign compare_line = item.variant.compare_at_price | times: item.quantity -%}
      <s class="cart-item__compare text-tiny text-muted">{{ compare_line | money }}</s>
    {%- endif -%}
    {%- if settings.cart_show_savings and line_saving > 0 -%}
      <span class="cart-item__saving text-tiny text-sale">
        {{- 'cart.general.savings' | t }} {{ line_saving | money -}}
      </span>
    {%- endif -%}
  </div>
</li>
