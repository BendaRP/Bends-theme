{%- comment -%}
  Renders one icon from the built-in set.

  Accepts:
  - icon:  {String} the icon name
  - class: {String} optional extra class names
{%- endcomment -%}
{%- liquid
  assign icon_class = 'icon'
  if class != blank
    assign icon_class = icon_class | append: ' ' | append: class
  endif
-%}
