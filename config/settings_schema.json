      { "type": "header", "content": "Refer a friend" },
      { "type": "checkbox", "id": "referral_enabled", "label": "Show the refer a friend panel", "default": false },
      { "type": "url", "id": "referral_page", "label": "Referral programme page", "visible_if": "{{ settings.referral_enabled }}" }
