          { "value": "center", "label": "Centre of the screen" }
        ],
        "default": "bottom",
        "visible_if": "{{ settings.cookie_banner_enabled }}"
      },
      { "type": "checkbox", "id": "cookie_banner_block", "label": "Dim the page until a choice is made", "default": false, "visible_if": "{{ settings.cookie_banner_enabled }}" },
      { "type": "url", "id": "cookie_policy_url", "label": "Privacy policy page", "visible_if": "{{ settings.cookie_banner_enabled }}" },
      { "type": "header", "content": "Accessibility" },
      { "type": "checkbox", "id": "accessibility_widget_enabled", "label": "Show the accessibility tools button", "default": true },
      {
        "type": "select",
        "id": "accessibility_widget_position",
        "label": "Button position",
        "options": [
          { "value": "start-middle", "label": "Middle, start of line" },
          { "value": "end-middle", "label": "Middle, end of line" },
          { "value": "start-bottom", "label": "Bottom, start of line" },
          { "value": "end-bottom", "label": "Bottom, end of line" }
        ],
        "default": "start-middle",
        "visible_if": "{{ settings.accessibility_widget_enabled }}"
      },
      { "type": "url", "id": "accessibility_statement_url", "label": "Accessibility statement page", "visible_if": "{{ settings.accessibility_widget_enabled }}" },
      { "type": "text", "id": "accessibility_contact", "label": "Accessibility coordinator contact", "info": "Name, email or phone. Shown in the accessibility panel.", "visible_if": "{{ settings.accessibility_widget_enabled }}" }
