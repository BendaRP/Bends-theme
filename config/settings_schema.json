  {
    "name": "Currency and language",
    "settings": [
      { "type": "checkbox", "id": "show_country_selector", "label": "Show the country and currency selector", "default": true, "info": "Only appears when more than one market is published in your markets settings." },
      { "type": "checkbox", "id": "show_language_selector", "label": "Show the language selector", "default": true, "info": "Only appears when more than one language is published." },
      { "type": "checkbox", "id": "show_currency_code", "label": "Always show the currency code beside prices", "default": false }
    ]
  },

