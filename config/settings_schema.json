      { "type": "checkbox", "id": "predictive_search_show_collections", "label": "Suggest collections", "default": true, "visible_if": "{{ settings.predictive_search_enabled }}" },
      { "type": "checkbox", "id": "predictive_search_show_pages", "label": "Suggest pages", "default": true, "visible_if": "{{ settings.predictive_search_enabled }}" },
      { "type": "checkbox", "id": "predictive_search_show_articles", "label": "Suggest articles", "default": true, "visible_if": "{{ settings.predictive_search_enabled }}" },
      { "type": "checkbox", "id": "predictive_search_show_queries", "label": "Suggest search terms", "default": true, "visible_if": "{{ settings.predictive_search_enabled }}" },
