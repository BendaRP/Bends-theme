          { "value": "page", "label": "Go to the cart page" },
          { "value": "popup", "label": "Confirmation popup" }
        ],
        "default": "drawer"
      },
      {
        "type": "select",
        "id": "cart_icon",
        "label": "Cart icon",
        "options": [
          { "value": "bag", "label": "Bag" },
          { "value": "tote", "label": "Tote" },
          { "value": "cart", "label": "Trolley" },
          { "value": "basket", "label": "Basket" },
          { "value": "text", "label": "Wording only" }
        ],
        "default": "bag"
      },
      { "type": "checkbox", "id": "cart_drawer_full_width_mobile", "label": "Full width drawer on mobile", "default": true },
      { "type": "checkbox", "id": "cart_show_savings", "label": "Show the amount saved per line and in total", "default": true },
      { "type": "checkbox", "id": "cart_show_compare_price", "label": "Show the compare-at price per line", "default": true },
      { "type": "checkbox", "id": "cart_note_enabled", "label": "Let shoppers add an order note", "default": true },
      { "type": "checkbox", "id": "cart_discount_field", "label": "Show a discount code field in the cart", "default": true, "info": "The code is applied at checkout. Shoppers can still enter codes at checkout as usual." },
      { "type": "header", "content": "Free shipping bar" },
      { "type": "checkbox", "id": "cart_free_shipping_enabled", "label": "Show progress to free shipping", "default": true },
