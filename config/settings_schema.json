      { "type": "header", "content": "Milestones" },
      { "type": "paragraph", "content": "Optional second and third rewards along the same progress bar, for example a free gift. Set these up as automatic discounts in your admin first." },
      { "type": "checkbox", "id": "cart_milestones_enabled", "label": "Show extra milestones", "default": false },
      { "type": "text", "id": "cart_milestone_2_amount", "label": "Second milestone amount", "default": "400", "visible_if": "{{ settings.cart_milestones_enabled }}" },
      { "type": "text", "id": "cart_milestone_2_label", "label": "Second milestone reward", "default": "Free gift", "visible_if": "{{ settings.cart_milestones_enabled }}" },
      { "type": "text", "id": "cart_milestone_3_amount", "label": "Third milestone amount", "default": "600", "visible_if": "{{ settings.cart_milestones_enabled }}" },
      { "type": "text", "id": "cart_milestone_3_label", "label": "Third milestone reward", "default": "VIP gift box", "visible_if": "{{ settings.cart_milestones_enabled }}" },
      { "type": "header", "content": "Terms" },
      { "type": "checkbox", "id": "cart_terms_required", "label": "Require agreement to the terms before checkout", "default": true, "info": "Commonly required for Israeli storefronts. The shopper cannot reach checkout until the box is ticked." },
      { "type": "url", "id": "cart_terms_url", "label": "Terms page", "visible_if": "{{ settings.cart_terms_required }}" },
      { "type": "header", "content": "Reassurance" },
      { "type": "checkbox", "id": "cart_show_payment_icons", "label": "Show payment icons", "default": true },
      { "type": "checkbox", "id": "cart_show_trust_badge", "label": "Show a security badge", "default": true }
    ]
  },

  {
    "name": "Search",
    "settings": [
      { "type": "checkbox", "id": "predictive_search_enabled", "label": "Suggest results as the shopper types", "default": true },
