{%- if settings.card_show_quick_view -%}
  <quick-view-modal class="quick-view" data-quick-view-modal hidden>
    <div class="quick-view__scrim" data-quick-view-close></div>
    <div class="quick-view__panel color-{{ section.settings.color_scheme }}" role="dialog" aria-modal="true" aria-label="{{ 'products.product.quick_view' | t }}">
      <button
        class="quick-view__close tap-target"
        type="button"
        data-quick-view-close
        aria-label="{{ 'general.close' | t }}"
      >
        {% render 'icon', icon: 'close', class: 'icon--large' %}
      </button>
      <div class="quick-view__body" data-quick-view-body>
        <div class="quick-view__loading">
          <span class="spinner"></span>
          <span class="visually-hidden">{{ 'general.loading' | t }}</span>
        </div>
      </div>
    </div>
  </quick-view-modal>
{%- endif -%}

{% schema %}
{
  "name": "Quick view",
  "settings": [
    { "type": "paragraph", "content": "Quick view opens a product in a dialog straight from a collection grid, so shoppers never lose their place. Turn it on under Product cards in Theme settings." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" }
  ],
  "enabled_on": { "groups": ["overlay"] }
}
{% endschema %}
