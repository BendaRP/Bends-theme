<div class="password-page color-{{ section.settings.color_scheme }}">
  {%- if section.settings.background != blank -%}
    <div class="password-page__background">
      {%- render 'responsive-image', image: section.settings.background, sizes: '100vw', priority: true -%}
    </div>
  {%- endif -%}

  <div class="password-page__inner">
    <div class="password-page__brand">
      {%- if settings.logo != blank -%}
        <div style="--password-logo-width: {{ settings.logo_width }}px;">
          {%- render 'responsive-image',
            image: settings.logo,
            widths: '120,180,260,360',
            sizes: 'var(--password-logo-width)',
            max_width: 360,
            alt: shop.name,
            priority: true
          -%}
        </div>
      {%- else -%}
        <h1 class="h2">{{ shop.name }}</h1>
      {%- endif -%}
    </div>

    {%- if section.settings.heading != blank -%}
      {%- render 'heading', text: section.settings.heading, tag: 'h2', size: 'h2', ink: true -%}
    {%- endif -%}

    {%- if section.settings.text != blank -%}
      <div class="rte text-lead">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- if section.settings.show_newsletter -%}
      {%- render 'newsletter-form', context: 'password', button_label: section.settings.newsletter_button -%}
    {%- endif -%}

    <div class="password-page__login">
      {%- form 'storefront_password', class: 'password-page__form' -%}
        {%- if form.errors -%}
          <p class="form-status form-status--error" tabindex="-1">{{ form.errors.messages.form }}</p>
        {%- endif -%}
        <details class="password-page__disclosure">
          <summary class="button button--link">{{ 'general.password_page.login_form_heading' | t }}</summary>
          <div class="password-page__field">
            <label class="visually-hidden" for="PasswordInput">
              {{- 'general.password_page.login_form_password_label' | t -}}
            </label>
            <input
              id="PasswordInput"
              type="password"
              name="password"
              placeholder="{{ 'general.password_page.login_form_password_placeholder' | t | escape }}"
              autocomplete="current-password"
            >
            <button type="submit" class="button button--small">
              {{ 'general.password_page.login_form_submit' | t }}
            </button>
          </div>
        </details>
      {%- endform -%}

      <p class="text-tiny text-muted">{{ 'general.password_page.admin_link_html' | t }}</p>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-3" },
    { "type": "image_picker", "id": "background", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Something good is coming" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We're putting the finishing touches to the shop. Leave your email and you'll be first through the door.</p>" },
    { "type": "checkbox", "id": "show_newsletter", "label": "Show the email sign-up", "default": true },
    { "type": "text", "id": "newsletter_button", "label": "Sign-up button label", "default": "Notify me" }
  ]
}
{% endschema %}
