{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    <div class="{{ section.settings.width }}">
      {%- render 'section-header', s: section.settings -%}

      <div class="video-section" data-reveal>
        {%- if section.settings.video != blank -%}
          <div class="frame" data-ratio="{{ section.settings.ratio }}">
            {{
              section.settings.video
              | video_tag:
                image_size: '1600x',
                controls: true,
                autoplay: section.settings.autoplay,
                loop: section.settings.loop,
                muted: section.settings.autoplay,
                playsinline: true
            }}
          </div>
        {%- elsif section.settings.video_url != blank -%}
          <video-facade
            class="video-facade"
            data-video-facade
            data-ratio="{{ section.settings.ratio }}"
          >
            <div class="frame" data-ratio="{{ section.settings.ratio }}">
              {%- if section.settings.cover_image != blank -%}
                {%- render 'responsive-image', image: section.settings.cover_image, sizes: '100vw' -%}
              {%- else -%}
                <div class="media-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
              {%- endif -%}
              <button class="video-facade__play" type="button" data-video-play aria-label="{{ 'accessibility.play_video' | t }}">
                {% render 'icon', icon: 'play', class: 'icon--xl' %}
              </button>
            </div>
            <template data-video-embed>
              {{ section.settings.video_url | external_video_tag: loading: 'lazy', autoplay: true }}
            </template>
          </video-facade>
        {%- else -%}
          <div class="frame" data-ratio="{{ section.settings.ratio }}">
            <div class="media-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "class": "section-video",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "page-width page-width--narrow",
          "label": "Narrow"
        },
        {
          "value": "page-width page-width--wide",
          "label": "Wide"
        },
        {
          "value": "page-width page-width--full",
          "label": "Full bleed"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "video",
      "id": "video",
      "label": "Video",
      "info": "Upload an MP4 to your files. Hosted by Shopify, so nothing third-party loads."
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "Or a video link",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "info": "Loaded only after the visitor presses play, so it never slows the first paint."
    },
    {
      "type": "image_picker",
      "id": "cover_image",
      "label": "Cover image"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "options": [
        {
          "value": "wide",
          "label": "16:9"
        },
        {
          "value": "landscape",
          "label": "4:3"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        }
      ],
      "default": "wide"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Play automatically",
      "default": false,
      "info": "Autoplaying video is always muted."
    },
    {
      "type": "checkbox",
      "id": "loop",
      "label": "Loop",
      "default": false
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "לראות את זה בפעולה"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h4",
          "label": "Extra small"
        },
        {
          "value": "h3",
          "label": "Small"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Display"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "ink_heading",
      "label": "Underline the last word with the ink accent",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start of line"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End of line"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Video"
    }
  ]
}
{% endschema %}
