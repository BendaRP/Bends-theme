{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section section--flush">
    {%- if section.blocks.size > 0 -%}
      <media-slider
        class="slideshow slideshow--{{ section.settings.height }}"
        data-slider
        data-autoplay="{{ section.settings.autoplay }}"
        data-speed="{{ section.settings.speed | times: 1000 }}"
      >
        <div class="slideshow__track" data-slider-track>
          {%- for block in section.blocks -%}
            <div class="slideshow__slide" {{ block.shopify_attributes }}>
              <div class="slideshow__media">
                {%- if block.settings.video != blank -%}
                  {{ block.settings.video | video_tag: image_size: '1600x', autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
                {%- elsif block.settings.image != blank -%}
                  {%- render 'responsive-image', image: block.settings.image, sizes: '100vw', priority: forloop.first -%}
                {%- else -%}
                  <div class="media-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
                {%- endif -%}
                {%- if block.settings.overlay_opacity > 0 -%}
                  {%- assign slide_overlay = block.settings.overlay_opacity | divided_by: 100.0 -%}
                  <span class="slideshow__overlay" style="--overlay-opacity: {{ slide_overlay }};" aria-hidden="true"></span>
                {%- endif -%}
              </div>

              <div class="slideshow__content slideshow__content--{{ block.settings.position }} color-{{ block.settings.color_scheme }}">
                <div class="slideshow__text text-{{ block.settings.alignment }}">
                  {%- if block.settings.eyebrow != blank -%}
                    <span class="eyebrow">{{ block.settings.eyebrow }}</span>
                  {%- endif -%}
                  {%- render 'heading', text: block.settings.heading, tag: 'h2', size: block.settings.heading_size, ink: block.settings.ink -%}
                  {%- if block.settings.text != blank -%}
                    <div class="rte text-lead">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <a class="button button--large" href="{{ block.settings.button_link | default: '#' }}">
                      {{ block.settings.button_label }}
                    </a>
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <div class="slideshow__controls">
            <button class="slider__arrow tap-target" type="button" data-slider-prev aria-label="{{ 'accessibility.previous_slide' | t }}">
              {% render 'icon', icon: 'chevron-left' %}
            </button>
            <ul class="slideshow__dots">
              {%- for block in section.blocks -%}
                <li>
                  <button
                    class="slideshow__dot"
                    type="button"
                    data-slider-dot
                    aria-label="{{ 'accessibility.slide_of' | t: current: forloop.index, total: section.blocks.size }}"
                  ></button>
                </li>
              {%- endfor -%}
            </ul>
            <button class="slider__arrow tap-target" type="button" data-slider-next aria-label="{{ 'accessibility.next_slide' | t }}">
              {% render 'icon', icon: 'chevron-right' %}
            </button>
          </div>
        {%- endif -%}
      </media-slider>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Slideshow",
  "tag": "section",
  "class": "section-slideshow",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        },
        {
          "value": "full",
          "label": "Full screen"
        }
      ],
      "default": "large"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Move automatically",
      "default": true,
      "info": "Pauses on hover, on focus, and for visitors who ask their device to reduce motion."
    },
    {
      "type": "range",
      "id": "speed",
      "min": 3,
      "max": 15,
      "step": 1,
      "unit": "s",
      "label": "Seconds per slide",
      "default": 6
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 0
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Video",
          "info": "Replaces the image. Upload an MP4 to your files."
        },
        {
          "type": "range",
          "id": "overlay_opacity",
          "min": 0,
          "max": 80,
          "step": 5,
          "unit": "%",
          "label": "Overlay",
          "default": 25
        },
        {
          "type": "color_scheme",
          "id": "color_scheme",
          "label": "Text colour scheme",
          "default": "scheme-3"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "inline_richtext",
          "id": "heading",
          "label": "Heading",
          "default": "חדש השבוע"
        },
        {
          "type": "select",
          "id": "heading_size",
          "label": "Heading size",
          "options": [
            {
              "value": "h2",
              "label": "Medium"
            },
            {
              "value": "h1",
              "label": "Large"
            },
            {
              "value": "h0",
              "label": "Display"
            }
          ],
          "default": "h1"
        },
        {
          "type": "checkbox",
          "id": "ink",
          "label": "Underline the last word with the ink accent",
          "default": false
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "לקולקציה"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        },
        {
          "type": "select",
          "id": "position",
          "label": "Content position",
          "options": [
            {
              "value": "start",
              "label": "Start of line"
            },
            {
              "value": "center",
              "label": "Centre"
            },
            {
              "value": "end",
              "label": "End of line"
            },
            {
              "value": "bottom",
              "label": "Bottom"
            }
          ],
          "default": "center"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Text alignment",
          "options": [
            {
              "value": "start",
              "label": "Start of line"
            },
            {
              "value": "center",
              "label": "Centre"
            },
            {
              "value": "end",
              "label": "End of line"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Slideshow",
      "blocks": [
        {
          "type": "slide"
        },
        {
          "type": "slide"
        }
      ]
    }
  ]
}
{% endschema %}
