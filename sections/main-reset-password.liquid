{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
  <div class="section">
    <div class="page-width page-width--narrow">
      <div class="account-form">
        <h1 class="h3">{{ 'customer.reset_password.title' | t }}</h1>

        {%- form 'reset_customer_password' -%}
          {%- if form.errors -%}
            <p class="form-status form-status--error" tabindex="-1">{{ form.errors.messages.form }}</p>
          {%- endif -%}
          <div class="field">
            <label class="field__label" for="ResetPassword">{{ 'customer.reset_password.password' | t }}</label>
            <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
          </div>
          <div class="field">
            <label class="field__label" for="ResetPasswordConfirm">{{ 'customer.reset_password.password_confirm' | t }}</label>
            <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
          </div>
          <button type="submit" class="button button--full">{{ 'customer.reset_password.submit' | t }}</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Reset password",
  "tag": "section",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 64 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ]
}
{% endschema %}
