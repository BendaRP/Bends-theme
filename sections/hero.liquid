      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "proof",
      "name": "Reassurance",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "return",
              "label": "Returns"
            },
            {
              "value": "leaf",
              "label": "Sustainable"
            },
            {
              "value": "award",
              "label": "Award"
            },
            {
              "value": "shield-check",
              "label": "Secure"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            }
          ],
          "default": "truck"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Free shipping over 250"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        {
          "type": "proof"
        }
      ]
    }
  ]
}
{% endschema %}
