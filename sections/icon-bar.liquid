{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <div class="section-wrapper color-{{ section.settings.color_scheme }}">
    <div class="section">
      <div class="page-width">
        <ul class="icon-bar icon-bar--{{ section.settings.layout }}" style="--icon-bar-columns: {{ section.blocks.size }};">
          {%- for block in section.blocks -%}
            <li
              class="icon-bar__item"
              data-reveal
              style="--reveal-delay: calc(var(--stagger) * {{ forloop.index0 }});"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                <div class="icon-bar__image" style="--icon-size: {{ section.settings.icon_size }}px;">
                  {%- render 'responsive-image', image: block.settings.image, widths: '48,72,96,144,192', sizes: 'var(--icon-size)', max_width: 192 -%}
                </div>
              {%- elsif block.settings.icon != 'none' -%}
                {% render 'icon', icon: block.settings.icon, class: 'icon-bar__icon' %}
              {%- endif -%}
              <div class="icon-bar__body">
                {%- if block.settings.heading != blank -%}
                  <span class="icon-bar__heading">{{ block.settings.heading }}</span>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <span class="icon-bar__text text-small text-muted">{{ block.settings.text }}</span>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Icon bar",
  "tag": "section",
  "class": "section-icon-bar",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-2"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "row",
          "label": "Icon beside the text"
        },
        {
          "value": "stacked",
          "label": "Icon above the text"
        }
      ],
      "default": "row"
    },
    {
      "type": "range",
      "id": "icon_size",
      "min": 24,
      "max": 96,
      "step": 4,
      "unit": "px",
      "label": "Icon size",
      "default": 32
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "package",
              "label": "Package"
            },
            {
              "value": "return",
              "label": "Returns"
            },
            {
              "value": "shield-check",
              "label": "Secure"
            },
            {
              "value": "lock",
              "label": "Lock"
            },
            {
              "value": "gift",
              "label": "Gift"
            },
            {
              "value": "leaf",
              "label": "Sustainable"
            },
            {
              "value": "award",
              "label": "Award"
            },
            {
              "value": "chat",
              "label": "Support"
            },
            {
              "value": "phone",
              "label": "Phone"
            },
            {
              "value": "store",
              "label": "Store"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "clock",
              "label": "Time"
            },
            {
              "value": "credit-card",
              "label": "Payment"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "globe",
              "label": "Worldwide"
            }
          ],
          "default": "truck"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Custom icon",
          "info": "Replaces the icon above."
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "משלוח מהיר"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "נשלח תוך יום עסקים אחד"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Icon bar",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "truck",
            "heading": "Fast delivery"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "return",
            "heading": "Easy returns"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "shield-check",
            "heading": "Secure payment"
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "chat",
            "heading": "Real people"
          }
        }
      ]
    }
  ]
}
{% endschema %}
