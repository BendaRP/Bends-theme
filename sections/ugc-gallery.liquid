{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    <div class="{{ section.settings.width }}">
      {%- render 'section-header', s: section.settings -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="ugc" style="--ugc-columns: {{ section.settings.columns }};">
          {%- for block in section.blocks -%}
            <li
              class="ugc__item"
              data-reveal
              style="--reveal-delay: calc(var(--stagger) * {{ forloop.index0 }});"
              {{ block.shopify_attributes }}
            >
              <div class="frame" data-ratio="square">
                {%- if block.settings.image != blank -%}
                  {%- render 'responsive-image', image: block.settings.image, sizes: '(min-width: 750px) 20vw, 45vw' -%}
                {%- else -%}
                  <div class="media-placeholder">{{ 'lifestyle-2' | placeholder_svg_tag }}</div>
                {%- endif -%}

                {%- if block.settings.product != blank -%}
                  <a class="ugc__shop" href="{{ block.settings.product.url }}">
                    {% render 'icon', icon: 'bag' %}
                    <span class="text-tiny">{{ 'sections.instagram.shop_the_look' | t }}</span>
                  </a>
                {%- elsif block.settings.link != blank -%}
                  <a class="ugc__shop" href="{{ block.settings.link }}" target="_blank" rel="noopener">
                    {% render 'icon', icon: 'instagram' %}
                    <span class="visually-hidden">{{ 'sections.instagram.follow' | t }}</span>
                  </a>
                {%- endif -%}

                {%- if block.settings.handle != blank -%}
                  <span class="ugc__handle text-tiny">{{ block.settings.handle }}</span>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.follow_link != blank -%}
        <div class="section-footer text-center">
          <a class="button button--secondary" href="{{ section.settings.follow_link }}" target="_blank" rel="noopener">
            {% render 'icon', icon: 'instagram' %}
            <span>{{ 'sections.instagram.follow' | t }}</span>
          </a>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Customer gallery",
  "tag": "section",
  "class": "section-ugc",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "page-width page-width--narrow",
          "label": "Narrow"
        },
        {
          "value": "page-width page-width--wide",
          "label": "Wide"
        },
        {
          "value": "page-width page-width--full",
          "label": "Full bleed"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "paragraph",
      "content": "Upload the photos you have permission to use. Each one can link straight to the product in it."
    },
    {
      "type": "range",
      "id": "columns",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Columns",
      "default": 5
    },
    {
      "type": "url",
      "id": "follow_link",
      "label": "Follow link"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Worn by you"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h4",
          "label": "Extra small"
        },
        {
          "value": "h3",
          "label": "Small"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Display"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "ink_heading",
      "label": "Underline the last word with the ink accent",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start of line"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End of line"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "photo",
      "name": "Photo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "product",
          "id": "product",
          "label": "Product in the photo"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Or a link",
          "info": "Used when no product is chosen."
        },
        {
          "type": "text",
          "id": "handle",
          "label": "Credit",
          "default": "@customer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Customer gallery",
      "blocks": [
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        },
        {
          "type": "photo"
        }
      ]
    }
  ]
}
{% endschema %}
