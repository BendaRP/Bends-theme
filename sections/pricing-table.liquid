{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    <div class="{{ section.settings.width }}">
      {%- render 'section-header', s: section.settings -%}

      {%- if section.blocks.size > 0 -%}
        <div class="pricing" style="--pricing-columns: {{ section.blocks.size }};">
          {%- for block in section.blocks -%}
            <div
              class="pricing__plan{% if block.settings.featured %} pricing__plan--featured{% endif %}"
              data-reveal
              style="--reveal-delay: calc(var(--stagger) * {{ forloop.index0 }});"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.badge != blank -%}
                <span class="badge badge--new pricing__badge">{{ block.settings.badge }}</span>
              {%- endif -%}

              <h3 class="pricing__name h5">{{ block.settings.name }}</h3>
              <p class="pricing__price h2">
                {{ block.settings.price }}
                {%- if block.settings.period != blank -%}
                  <span class="pricing__period text-small text-muted">{{ block.settings.period }}</span>
                {%- endif -%}
              </p>
              {%- if block.settings.description != blank -%}
                <p class="text-small text-muted">{{ block.settings.description }}</p>
              {%- endif -%}

              {%- if block.settings.features != blank -%}
                <ul class="pricing__features">
                  {%- assign feature_lines = block.settings.features | newline_to_br | split: '<br />' -%}
                  {%- for line in feature_lines -%}
                    {%- assign feature = line | strip -%}
                    {%- if feature != blank -%}
                      <li>
                        {% render 'icon', icon: 'check' %}
                        <span class="text-small">{{ feature }}</span>
                      </li>
                    {%- endif -%}
                  {%- endfor -%}
                </ul>
              {%- endif -%}

              {%- if block.settings.button_label != blank -%}
                <a
                  class="button button--full{% unless block.settings.featured %} button--secondary{% endunless %}"
                  href="{{ block.settings.button_link | default: '#' }}"
                >
                  {{ block.settings.button_label }}
                </a>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Pricing table",
  "tag": "section",
  "class": "section-pricing-table",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "page-width page-width--narrow",
          "label": "Narrow"
        },
        {
          "value": "page-width page-width--wide",
          "label": "Wide"
        },
        {
          "value": "page-width page-width--full",
          "label": "Full bleed"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "בחרו מסלול"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h4",
          "label": "Extra small"
        },
        {
          "value": "h3",
          "label": "Small"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Display"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "ink_heading",
      "label": "Underline the last word with the ink accent",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start of line"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End of line"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "plan",
      "name": "Plan",
      "limit": 4,
      "settings": [
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "רגיל"
        },
        {
          "type": "text",
          "id": "price",
          "label": "Price",
          "default": "₪99"
        },
        {
          "type": "text",
          "id": "period",
          "label": "Period",
          "default": "לחודש"
        },
        {
          "type": "text",
          "id": "description",
          "label": "Description",
          "default": "כל מה שרוב האנשים צריכים."
        },
        {
          "type": "textarea",
          "id": "features",
          "label": "Features",
          "default": "משלוח חינם\nתמיכה מועדפת\nביטול בכל עת",
          "info": "One per line."
        },
        {
          "type": "checkbox",
          "id": "featured",
          "label": "Highlight this plan",
          "default": false
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "בחירה"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Pricing table",
      "blocks": [
        {
          "type": "plan"
        },
        {
          "type": "plan",
          "settings": {
            "featured": true
          }
        },
        {
          "type": "plan"
        }
      ]
    }
  ]
}
{% endschema %}
