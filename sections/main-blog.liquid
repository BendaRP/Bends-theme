{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
  #shopify-section-{{ section.id }} { --grid-mobile: 1; }
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
  <div class="section">
    <div class="page-width">
      {%- if section.settings.show_breadcrumbs -%}
        {%- render 'breadcrumbs' -%}
      {%- endif -%}
      {%- render 'heading', text: blog.title, tag: 'h1', size: 'h1', ink: section.settings.ink_heading -%}

      {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
        <ul class="blog-tags">
          <li>
            <a class="blog-tags__tag{% unless current_tags %} is-active{% endunless %}" href="{{ blog.url }}">
              {{ 'collections.general.view_all' | t }}
            </a>
          </li>
          {%- for tag in blog.all_tags -%}
            <li>
              <a
                class="blog-tags__tag{% if current_tags contains tag %} is-active{% endif %}"
                href="{{ blog.url }}/tagged/{{ tag | handle }}"
              >
                {{ tag }}
              </a>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if blog.articles.size > 0 -%}
        {%- paginate blog.articles by section.settings.posts_per_page -%}
          <div class="grid grid--{{ section.settings.columns }}{% if section.settings.offset_grid %} grid--offset{% endif %}" id="BlogGrid">
            {%- for article in blog.articles -%}
              {%- render 'article-card', article: article, index: forloop.index0, show_excerpt: section.settings.show_excerpt -%}
            {%- endfor -%}
          </div>
          {%- render 'pagination', paginate: paginate, anchor: '#BlogGrid' -%}
        {%- endpaginate -%}
      {%- else -%}
        <p class="text-muted">{{ 'blogs.article.empty' | t }}</p>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog",
  "tag": "section",
  "class": "section-main-blog",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "checkbox", "id": "ink_heading", "label": "Underline the last word with the ink accent", "default": true },
    { "type": "checkbox", "id": "show_tags", "label": "Show tag filters", "default": true },
    { "type": "checkbox", "id": "show_excerpt", "label": "Show excerpts", "default": true },
    { "type": "checkbox", "id": "offset_grid", "label": "Stagger alternate cards", "default": true },
    { "type": "range", "id": "posts_per_page", "min": 3, "max": 24, "step": 3, "label": "Articles per page", "default": 9 },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ]
}
{% endschema %}
