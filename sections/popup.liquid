{%- if section.settings.enabled -%}
  <site-popup
    class="popup popup--{{ section.settings.size }} color-{{ section.settings.color_scheme }}"
    data-popup-id="{{ section.id }}"
    data-trigger="{{ section.settings.trigger }}"
    data-delay="{{ section.settings.delay }}"
    data-scroll-percent="{{ section.settings.scroll_percent }}"
    hidden
  >
    <div class="popup__scrim" data-popup-close></div>

    <div class="popup__panel" data-popup-panel role="dialog" aria-modal="true" aria-labelledby="PopupTitle-{{ section.id }}">
      <button class="popup__close tap-target" type="button" data-popup-close aria-label="{{ 'sections.popup.close' | t }}">
        {% render 'icon', icon: 'close', class: 'icon--large' %}
      </button>

      {%- if section.settings.image != blank -%}
        <div class="popup__media">
          <div class="frame" data-ratio="{{ section.settings.image_ratio }}">
            {%- render 'responsive-image', image: section.settings.image, sizes: '(min-width: 750px) 380px, 90vw', max_width: 900 -%}
          </div>
        </div>
      {%- endif -%}

      <div class="popup__body">
        {%- if section.settings.eyebrow != blank -%}
          <span class="eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2 class="h3" id="PopupTitle-{{ section.id }}">{{ section.settings.heading }}</h2>
        {%- if section.settings.text != blank -%}
          <div class="rte text-small">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.show_form -%}
          {%- render 'newsletter-form', context: section.id, button_label: section.settings.button_label -%}
        {%- elsif section.settings.button_label != blank -%}
          <a class="button button--full" href="{{ section.settings.button_link | default: '#' }}">
            {{ section.settings.button_label }}
          </a>
        {%- endif -%}

        {%- if section.settings.code != blank -%}
          <button class="discount-code__button" type="button" data-copy="{{ section.settings.code }}">
            <span class="discount-code__value">{{ section.settings.code }}</span>
            {% render 'icon', icon: 'copy' %}
          </button>
        {%- endif -%}

        <button class="button button--link text-tiny" type="button" data-popup-close>
          {{ 'sections.popup.no_thanks' | t }}
        </button>

        {%- if section.settings.disclaimer != blank -%}
          <div class="rte text-tiny text-muted">{{ section.settings.disclaimer }}</div>
        {%- endif -%}
      </div>
    </div>
  </site-popup>
{%- endif -%}

{% schema %}
{
  "name": "Popup",
  "tag": "section",
  "class": "section-popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show the popup",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "trigger",
      "label": "Show it",
      "options": [
        {
          "value": "delay",
          "label": "After a delay"
        },
        {
          "value": "scroll",
          "label": "After scrolling"
        },
        {
          "value": "exit",
          "label": "When the visitor looks like they are leaving"
        }
      ],
      "default": "delay"
    },
    {
      "type": "range",
      "id": "delay",
      "min": 2,
      "max": 60,
      "step": 1,
      "unit": "s",
      "label": "Delay",
      "default": 8
    },
    {
      "type": "range",
      "id": "scroll_percent",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Scroll depth",
      "default": 40
    },
    {
      "type": "select",
      "id": "size",
      "label": "Size",
      "options": [
        {
          "value": "small",
          "label": "Small"
        },
        {
          "value": "medium",
          "label": "Medium"
        },
        {
          "value": "large",
          "label": "Large"
        }
      ],
      "default": "medium"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "landscape",
          "label": "Landscape"
        }
      ],
      "default": "portrait"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "לפני שאתם הולכים"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "עשרה אחוז הנחה על ההזמנה הראשונה"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>הצטרפו לרשימה ונשלח את הקוד מיד.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_form",
      "label": "Collect an email address",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "שלחו לי"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Used when the email field is switched off."
    },
    {
      "type": "text",
      "id": "code",
      "label": "Discount code to reveal"
    },
    {
      "type": "richtext",
      "id": "disclaimer",
      "label": "Small print",
      "default": "<p>בהרשמה אתם מאשרים את מדיניות הפרטיות שלנו.</p>"
    }
  ],
  "enabled_on": {
    "groups": [
      "overlay"
    ]
  }
}
{% endschema %}
