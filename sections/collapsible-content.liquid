{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    <div class="{{ section.settings.width }}">
      <div class="collapsible-content collapsible-content--{{ section.settings.layout }}">
        {%- if section.settings.image != blank and section.settings.layout == 'media' -%}
          <div class="collapsible-content__media" data-reveal>
            <div class="frame" data-ratio="portrait">
              {%- render 'responsive-image', image: section.settings.image, sizes: '(min-width: 750px) 40vw, 100vw' -%}
            </div>
          </div>
        {%- endif -%}

        <div class="collapsible-content__body">
          {%- render 'section-header', s: section.settings, anchor: section.settings.anchor_id -%}

          {%- if section.blocks.size > 0 -%}
            <div class="collapsible-list" data-accordion data-single="{{ section.settings.one_at_a_time }}">
              {%- for block in section.blocks -%}
                <details class="collapsible" {% if forloop.first and section.settings.open_first %}open{% endif %} {{ block.shopify_attributes }}>
                  <summary class="collapsible__summary">
                    <span class="collapsible__title">
                      {%- if block.settings.icon != 'none' -%}
                        {% render 'icon', icon: block.settings.icon %}
                      {%- endif -%}
                      {{ block.settings.heading }}
                    </span>
                    {% render 'icon', icon: 'chevron-down', class: 'collapsible__chevron' %}
                  </summary>
                  <div class="collapsible__body rte">
                    {%- if block.settings.page != blank -%}
                      {{ block.settings.page.content }}
                    {%- else -%}
                      {{ block.settings.text }}
                    {%- endif -%}
                  </div>
                </details>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
