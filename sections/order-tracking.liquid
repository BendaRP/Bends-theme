{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    <div class="{{ section.settings.width }} page-width--narrow">
      {%- render 'section-header', s: section.settings -%}

      <form class="order-tracking" action="{{ routes.account_url }}" method="get">
        <div class="order-tracking__fields">
          <div class="field">
            <label class="field__label" for="TrackOrder-{{ section.id }}">
              {{- 'sections.order_tracking.order_number' | t -}}
            </label>
            <input id="TrackOrder-{{ section.id }}" type="text" name="order" inputmode="numeric" required>
          </div>
          <div class="field">
            <label class="field__label" for="TrackEmail-{{ section.id }}">
              {{- 'sections.order_tracking.email' | t -}}
            </label>
            <input id="TrackEmail-{{ section.id }}" type="email" name="email" autocomplete="email" required>
          </div>
        </div>
        <button type="submit" class="button">{{ 'sections.order_tracking.submit' | t }}</button>
        <p class="text-tiny text-muted">{{ 'sections.order_tracking.help' | t }}</p>
      </form>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Order tracking",
  "tag": "section",
  "class": "section-order-tracking",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "page-width page-width--narrow",
          "label": "Narrow"
        },
        {
          "value": "page-width page-width--wide",
          "label": "Wide"
        },
        {
          "value": "page-width page-width--full",
          "label": "Full bleed"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Track your order"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h4",
          "label": "Extra small"
        },
        {
          "value": "h3",
          "label": "Small"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Display"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "ink_heading",
      "label": "Underline the last word with the ink accent",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start of line"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End of line"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Order tracking"
    }
  ]
}
{% endschema %}
