{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    <div class="{{ section.settings.width }}">
      {%- render 'section-header', s: section.settings -%}

      {%- if section.blocks.size > 0 -%}
        <div class="collage collage--{{ section.settings.layout }}">
          {%- for block in section.blocks -%}
            <div
              class="collage__item collage__item--{{ block.settings.size }}"
              data-reveal
              style="--reveal-delay: calc(var(--stagger) * {{ forloop.index0 }});"
              {{ block.shopify_attributes }}
            >
              <a class="collage__link" href="{{ block.settings.link | default: '#' }}">
                <div class="frame" data-ratio="{{ block.settings.ratio }}">
                  {%- if block.settings.image != blank -%}
                    {%- render 'responsive-image', image: block.settings.image, sizes: '(min-width: 990px) 40vw, 90vw' -%}
                  {%- else -%}
                    <div class="media-placeholder">{{ 'collection-1' | placeholder_svg_tag }}</div>
                  {%- endif -%}
                </div>
                <div class="collage__caption text-{{ block.settings.alignment }}">
                  {%- if block.settings.eyebrow != blank -%}
                    <span class="eyebrow">{{ block.settings.eyebrow }}</span>
                  {%- endif -%}
                  {%- if block.settings.heading != blank -%}
                    <span class="collage__heading h4">{{ block.settings.heading }}</span>
                  {%- endif -%}
                  {%- if block.settings.link_label != blank -%}
                    <span class="link text-small">{{ block.settings.link_label }}</span>
                  {%- endif -%}
                </div>
              </a>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collage",
  "tag": "section",
  "class": "section-collage",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "page-width page-width--narrow",
          "label": "Narrow"
        },
        {
          "value": "page-width page-width--wide",
          "label": "Wide"
        },
        {
          "value": "page-width page-width--full",
          "label": "Full bleed"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "mosaic",
          "label": "Mosaic"
        },
        {
          "value": "editorial",
          "label": "Editorial offset"
        },
        {
          "value": "even",
          "label": "Even"
        }
      ],
      "default": "editorial"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "לפי מצב רוח"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h4",
          "label": "Extra small"
        },
        {
          "value": "h3",
          "label": "Small"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Display"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "ink_heading",
      "label": "Underline the last word with the ink accent",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start of line"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End of line"
        }
      ],
      "default": "start"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "select",
      "id": "button_style",
      "label": "Button style",
      "options": [
        {
          "value": "",
          "label": "Primary"
        },
        {
          "value": "button--secondary",
          "label": "Secondary"
        },
        {
          "value": "button--ghost",
          "label": "Ghost"
        },
        {
          "value": "button--link",
          "label": "Link"
        }
      ],
      "default": "button--secondary"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "tile",
      "name": "Tile",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "eyebrow",
          "label": "Eyebrow"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "לכל יום"
        },
        {
          "type": "text",
          "id": "link_label",
          "label": "Link label",
          "default": "לקנייה"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "size",
          "label": "Size",
          "options": [
            {
              "value": "small",
              "label": "Small"
            },
            {
              "value": "medium",
              "label": "Medium"
            },
            {
              "value": "large",
              "label": "Large"
            }
          ],
          "default": "medium"
        },
        {
          "type": "select",
          "id": "ratio",
          "label": "Ratio",
          "options": [
            {
              "value": "square",
              "label": "Square"
            },
            {
              "value": "portrait",
              "label": "Portrait"
            },
            {
              "value": "landscape",
              "label": "Landscape"
            },
            {
              "value": "tall",
              "label": "Tall"
            }
          ],
          "default": "portrait"
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Caption alignment",
          "options": [
            {
              "value": "start",
              "label": "Start of line"
            },
            {
              "value": "center",
              "label": "Centre"
            }
          ],
          "default": "start"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Collage",
      "blocks": [
        {
          "type": "tile"
        },
        {
          "type": "tile"
        },
        {
          "type": "tile"
        }
      ]
    }
  ]
}
{% endschema %}
