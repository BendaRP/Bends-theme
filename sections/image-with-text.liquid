{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    <div class="{{ section.settings.width }}">
      <div class="image-with-text image-with-text--{{ section.settings.layout }} image-with-text--media-{{ section.settings.media_position }}">
        <div class="image-with-text__media" data-reveal>
          {%- if section.settings.video != blank -%}
            <div class="frame" data-ratio="{{ section.settings.image_ratio }}">
              {{ section.settings.video | video_tag: image_size: '1200x', controls: true, muted: true, playsinline: true }}
            </div>
          {%- elsif section.settings.image != blank -%}
            <div class="frame" data-ratio="{{ section.settings.image_ratio }}">
              {%- render 'responsive-image', image: section.settings.image, sizes: '(min-width: 750px) 50vw, 100vw' -%}
            </div>
          {%- else -%}
            <div class="frame" data-ratio="{{ section.settings.image_ratio }}">
              <div class="media-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
            </div>
          {%- endif -%}

          {%- if section.settings.secondary_image != blank -%}
            <div class="frame frame--soft image-with-text__inset" data-ratio="square">
              {%- render 'responsive-image', image: section.settings.secondary_image, sizes: '200px', max_width: 600 -%}
            </div>
          {%- endif -%}
        </div>

        <div class="image-with-text__body" data-reveal>
          {%- render 'section-header', s: section.settings -%}

          {%- if section.blocks.size > 0 -%}
            <ul class="image-with-text__list">
              {%- for block in section.blocks -%}
                <li class="image-with-text__item" {{ block.shopify_attributes }}>
                  {%- case block.type -%}
                    {%- when 'point' -%}
                      {%- if block.settings.icon != 'none' -%}
                        {% render 'icon', icon: block.settings.icon, class: 'icon--large' %}
                      {%- endif -%}
                      <div>
                        {%- if block.settings.heading != blank -%}
                          <strong class="image-with-text__item-heading">{{ block.settings.heading }}</strong>
                        {%- endif -%}
                        {%- if block.settings.text != blank -%}
                          <span class="text-small text-muted">{{ block.settings.text }}</span>
                        {%- endif -%}
                      </div>
                    {%- when 'stat' -%}
                      <div class="image-with-text__stat">
                        <b class="h3" data-counter="{{ block.settings.value }}">{{ block.settings.value }}</b>
                        <span class="text-small text-muted">{{ block.settings.label }}</span>
                      </div>
                  {%- endcase -%}
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
