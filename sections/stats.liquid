{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    {%- render 'section-background', s: section.settings -%}
    <div class="{{ section.settings.width }}">
      {%- render 'section-header', s: section.settings -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="stats" style="--stats-columns: {{ section.blocks.size }};">
          {%- for block in section.blocks -%}
            <li
              class="stats__item"
              data-reveal
              style="--reveal-delay: calc(var(--stagger) * {{ forloop.index0 }});"
              {{ block.shopify_attributes }}
            >
              <span class="stats__value h1">
                {%- if block.settings.prefix != blank -%}<span class="stats__affix">{{ block.settings.prefix }}</span>{%- endif -%}
                {%- if block.settings.animate -%}
                  <span data-counter="{{ block.settings.value }}">0</span>
                {%- else -%}
                  <span>{{ block.settings.value }}</span>
                {%- endif -%}
                {%- if block.settings.suffix != blank -%}<span class="stats__affix">{{ block.settings.suffix }}</span>{%- endif -%}
              </span>
              <span class="stats__label text-small">{{ block.settings.label }}</span>
              {%- if block.settings.text != blank -%}
                <span class="text-tiny text-muted">{{ block.settings.text }}</span>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Results",
  "tag": "section",
  "class": "section-stats",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-3"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "page-width page-width--narrow",
          "label": "Narrow"
        },
        {
          "value": "page-width page-width--wide",
          "label": "Wide"
        },
        {
          "value": "page-width page-width--full",
          "label": "Full bleed"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "The numbers"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h4",
          "label": "Extra small"
        },
        {
          "value": "h3",
          "label": "Small"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Display"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "ink_heading",
      "label": "Underline the last word with the ink accent",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start of line"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End of line"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "select",
      "id": "background_type",
      "label": "Background",
      "options": [
        {
          "value": "none",
          "label": "Colour scheme only"
        },
        {
          "value": "image",
          "label": "Image"
        },
        {
          "value": "video",
          "label": "Video"
        },
        {
          "value": "gradient",
          "label": "Gradient"
        }
      ],
      "default": "none"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "video",
      "id": "background_video",
      "label": "Background video",
      "info": "Upload an MP4 to your files. Hosted by Shopify, so no third-party player is loaded."
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background gradient"
    },
    {
      "type": "color",
      "id": "overlay_color",
      "label": "Overlay colour",
      "default": "#000000"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Overlay opacity",
      "default": 30
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Statistic",
      "limit": 6,
      "settings": [
        {
          "type": "text",
          "id": "prefix",
          "label": "Prefix"
        },
        {
          "type": "text",
          "id": "value",
          "label": "Value",
          "default": "12000"
        },
        {
          "type": "text",
          "id": "suffix",
          "label": "Suffix",
          "default": "+"
        },
        {
          "type": "checkbox",
          "id": "animate",
          "label": "Count up when it scrolls into view",
          "default": true
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Orders shipped"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Detail"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Results",
      "blocks": [
        {
          "type": "stat"
        },
        {
          "type": "stat"
        },
        {
          "type": "stat"
        }
      ]
    }
  ]
}
{% endschema %}
