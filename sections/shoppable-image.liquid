{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    <div class="{{ section.settings.width }}">
      {%- render 'section-header', s: section.settings -%}

      <div class="shoppable" data-reveal>
        <div class="frame shoppable__frame" data-ratio="{{ section.settings.ratio }}">
          {%- if section.settings.image != blank -%}
            {%- render 'responsive-image', image: section.settings.image, sizes: '(min-width: 990px) 70vw, 100vw' -%}
          {%- else -%}
            <div class="media-placeholder">{{ 'lifestyle-1' | placeholder_svg_tag }}</div>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- if block.settings.product != blank -%}
              <div
                class="shoppable__hotspot"
                style="--x: {{ block.settings.horizontal }}%; --y: {{ block.settings.vertical }}%;"
                {{ block.shopify_attributes }}
              >
                <button
                  class="shoppable__dot"
                  type="button"
                  aria-expanded="false"
                  aria-label="{{ block.settings.product.title | escape }}"
                  data-hotspot-toggle
                >
                  <span class="shoppable__pulse" aria-hidden="true"></span>
                  {% render 'icon', icon: 'plus' %}
                </button>

                <div class="shoppable__card" data-hotspot-card>
                  <a class="shoppable__card-link" href="{{ block.settings.product.url }}">
                    <div class="frame frame--soft" data-ratio="square">
                      {%- if block.settings.product.featured_media -%}
                        {%- render 'responsive-image',
                          image: block.settings.product.featured_media.preview_image,
                          widths: '80,120,160,240',
                          sizes: '72px',
                          max_width: 240
                        -%}
                      {%- else -%}
                        <div class="media-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
                      {%- endif -%}
                    </div>
                    <span class="shoppable__card-body">
                      <span class="text-small">{{ block.settings.product.title }}</span>
                      {%- render 'price', target: block.settings.product, class: 'price--small' -%}
                    </span>
                  </a>
                  {%- if block.settings.product.available -%}
                    <form action="{{ routes.cart_add_url }}" method="post" data-quick-add-form>
                      <input type="hidden" name="id" value="{{ block.settings.product.selected_or_first_available_variant.id }}">
                      <input type="hidden" name="quantity" value="1">
                      <button type="submit" class="button button--small button--full">
                        {{ 'products.product.quick_add' | t }}
                      </button>
                    </form>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Shoppable image",
  "tag": "section",
  "class": "section-shoppable-image",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "page-width page-width--narrow",
          "label": "Narrow"
        },
        {
          "value": "page-width page-width--wide",
          "label": "Wide"
        },
        {
          "value": "page-width page-width--full",
          "label": "Full bleed"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Ratio",
      "options": [
        {
          "value": "landscape",
          "label": "4:3"
        },
        {
          "value": "wide",
          "label": "16:9"
        },
        {
          "value": "square",
          "label": "Square"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        }
      ],
      "default": "landscape"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": ""
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "לקנות את הלוק"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h4",
          "label": "Extra small"
        },
        {
          "value": "h3",
          "label": "Small"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Display"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "ink_heading",
      "label": "Underline the last word with the ink accent",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start of line"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End of line"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "hotspot",
      "name": "Hotspot",
      "limit": 8,
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "range",
          "id": "horizontal",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Across",
          "default": 50
        },
        {
          "type": "range",
          "id": "vertical",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "label": "Down",
          "default": 50
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shoppable image",
      "blocks": [
        {
          "type": "hotspot"
        }
      ]
    }
  ]
}
{% endschema %}
