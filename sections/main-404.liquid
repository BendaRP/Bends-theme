{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
  <div class="section">
    <div class="page-width page-width--narrow text-center">
      <p class="error-page__code">404</p>
      {%- render 'heading',
        text: section.settings.heading,
        tag: 'h1',
        size: 'h1',
        ink: true
      -%}
      <p class="text-lead text-muted">{{ section.settings.text }}</p>

      <div class="error-page__search">
        {%- render 'predictive-search', context: 'error' -%}
      </div>

      <div class="cluster error-page__actions">
        <a class="button" href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        <a class="button button--secondary" href="{{ routes.all_products_collection_url }}">
          {{ 'collections.general.browse_all' | t }}
        </a>
      </div>

      {%- if section.settings.collection != blank -%}
        <div class="error-page__products">
          <h2 class="h5">{{ section.settings.collection_heading }}</h2>
          <div class="grid grid--4">
            {%- for product in section.settings.collection.products limit: 4 -%}
              {%- render 'product-card', product: product, index: forloop.index0 -%}
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "tag": "section",
  "class": "section-main-404",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "We couldn't find that page" },
    { "type": "text", "id": "text", "label": "Text", "default": "The link may have changed — there's still plenty to see." },
    { "type": "collection", "id": "collection", "label": "Suggested collection", "info": "A dead end is a lost sale. Point people somewhere." },
    { "type": "text", "id": "collection_heading", "label": "Suggestion heading", "default": "Popular right now" },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Top padding", "default": 80 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 200, "step": 4, "unit": "px", "label": "Bottom padding", "default": 80 }
  ]
}
{% endschema %}
