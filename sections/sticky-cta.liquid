{%- if section.settings.enabled -%}
  <sticky-cta
    class="sticky-cta sticky-cta--{{ section.settings.position }} color-{{ section.settings.color_scheme }}"
    data-sticky-cta
    data-scroll-percent="{{ section.settings.show_after }}"
    hidden
  >
    <div class="page-width sticky-cta__inner">
      <div class="sticky-cta__text">
        {%- if section.settings.heading != blank -%}
          <strong class="sticky-cta__heading">{{ section.settings.heading }}</strong>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <span class="text-small">{{ section.settings.text }}</span>
        {%- endif -%}
      </div>

      <div class="sticky-cta__actions">
        <a class="button" href="{{ section.settings.button_link | default: '#' }}">
          {{ section.settings.button_label }}
        </a>
        {%- if section.settings.dismissible -%}
          <button class="sticky-cta__close tap-target" type="button" data-sticky-cta-close aria-label="{{ 'general.close' | t }}">
            {% render 'icon', icon: 'close' %}
          </button>
        {%- endif -%}
      </div>
    </div>
  </sticky-cta>
{%- endif -%}

{% schema %}
{
  "name": "Sticky call to action",
  "tag": "section",
  "class": "section-sticky-cta",
  "settings": [
    {
      "type": "checkbox",
      "id": "enabled",
      "label": "Show the sticky bar",
      "default": false
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-4"
    },
    {
      "type": "select",
      "id": "position",
      "label": "Position",
      "options": [
        {
          "value": "bottom",
          "label": "Bottom"
        },
        {
          "value": "top",
          "label": "Top"
        }
      ],
      "default": "bottom"
    },
    {
      "type": "range",
      "id": "show_after",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "label": "Appear after scrolling",
      "default": 25
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "מבצע אמצע עונה"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "עד 50% הנחה, מסתיים ביום ראשון"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "למבצע"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "checkbox",
      "id": "dismissible",
      "label": "Let visitors dismiss it",
      "default": true
    }
  ],
  "enabled_on": {
    "groups": [
      "overlay"
    ]
  }
}
{% endschema %}
