{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<footer class="footer-wrapper color-{{ section.settings.color_scheme }}" role="contentinfo">
  <div class="section">
    <div class="page-width">
      {%- if section.blocks.size > 0 -%}
        <div class="footer__grid" style="--footer-columns: {{ section.blocks.size }};">
          {%- for block in section.blocks -%}
            <div class="footer__block footer__block--{{ block.type }}" {{ block.shopify_attributes }}>
              {%- case block.type -%}
                {%- when 'brand' -%}
                  {%- if settings.logo != blank -%}
                    <div class="footer__logo" style="--footer-logo-width: {{ block.settings.logo_width }}px;">
                      {%- render 'responsive-image',
                        image: settings.logo,
                        widths: '120,180,260,360',
                        sizes: 'var(--footer-logo-width)',
                        max_width: 360,
                        alt: shop.name
                      -%}
                    </div>
                  {%- else -%}
                    <span class="h4">{{ shop.name }}</span>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="rte text-small text-muted">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {%- if block.settings.show_social -%}
                    {%- render 'social-links' -%}
                  {%- endif -%}

                {%- when 'menu' -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="footer__heading h6">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.menu != blank -%}
                    <ul class="footer__list">
                      {%- for link in block.settings.menu.links -%}
                        <li><a class="footer__link" href="{{ link.url }}">{{ link.title }}</a></li>
                      {%- endfor -%}
                    </ul>
                  {%- endif -%}

                {%- when 'text' -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="footer__heading h6">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="rte text-small">{{ block.settings.text }}</div>
                  {%- endif -%}

                {%- when 'newsletter' -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="footer__heading h6">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="rte text-small text-muted">{{ block.settings.text }}</div>
                  {%- endif -%}
                  {%- render 'newsletter-form', context: block.id, button_label: block.settings.button_label -%}

                {%- when 'contact' -%}
                  {%- if block.settings.heading != blank -%}
                    <h2 class="footer__heading h6">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  <ul class="footer__list footer__list--contact">
                    {%- if block.settings.phone != blank -%}
                      <li>
                        <a class="footer__link" href="tel:{{ block.settings.phone | strip | replace: ' ', '' }}">
                          {% render 'icon', icon: 'phone' %}
                          <span>{{ block.settings.phone }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                    {%- if block.settings.email != blank -%}
                      <li>
                        <a class="footer__link" href="mailto:{{ block.settings.email }}">
                          {% render 'icon', icon: 'mail' %}
                          <span>{{ block.settings.email }}</span>
                        </a>
                      </li>
                    {%- endif -%}
                    {%- if block.settings.address != blank -%}
                      <li class="footer__contact-line">
                        {% render 'icon', icon: 'pin' %}
                        <span>{{ block.settings.address }}</span>
                      </li>
                    {%- endif -%}
                    {%- if block.settings.hours != blank -%}
                      <li class="footer__contact-line">
                        {% render 'icon', icon: 'clock' %}
                        <span>{{ block.settings.hours }}</span>
                      </li>
                    {%- endif -%}
                  </ul>

                {%- when 'image' -%}
                  {%- if block.settings.image != blank -%}
                    <div class="footer__image" style="--footer-image-width: {{ block.settings.image_width }}px;">
                      {%- render 'responsive-image',
                        image: block.settings.image,
                        widths: '120,200,320,480',
                        sizes: 'var(--footer-image-width)',
                        max_width: 480
                      -%}
                    </div>
                  {%- endif -%}
                  {%- if block.settings.text != blank -%}
                    <div class="rte text-tiny text-muted">{{ block.settings.text }}</div>
                  {%- endif -%}
              {%- endcase -%}
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}

      <div class="footer__bottom">
        <div class="footer__bottom-start">
          <p class="text-tiny text-muted">
            {{- 'sections.footer.copyright_html' | t: year: 'now' | date: '%Y', shop: shop.name -}}
          </p>
          {%- if section.settings.policy_menu != blank -%}
            <ul class="footer__policies">
              {%- for link in section.settings.policy_menu.links -%}
                <li><a class="footer__link text-tiny" href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
          {%- if settings.cookie_banner_enabled -%}
            <button class="footer__link text-tiny" type="button" data-cookie-reopen>
              {{- 'compliance.cookies.reopen' | t -}}
            </button>
          {%- endif -%}
        </div>

        <div class="footer__bottom-end">
          {%- if section.settings.show_localization -%}
            {%- render 'localization-form', context: 'footer', class: 'localization--footer' -%}
          {%- endif -%}
          {%- if section.settings.show_payment_icons -%}
            {%- render 'payment-icons' -%}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "section-footer",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-3" },
    { "type": "link_list", "id": "policy_menu", "label": "Legal menu", "info": "Privacy policy, terms, accessibility statement, returns." },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_localization", "label": "Show the country and language pickers", "default": true },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 72 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 40 }
  ],
  "blocks": [
    {
      "type": "brand",
      "name": "Brand",
      "limit": 1,
      "settings": [
        { "type": "range", "id": "logo_width", "min": 60, "max": 320, "step": 10, "unit": "px", "label": "Logo width", "default": 140 },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Made in small batches, shipped with care.</p>" },
        { "type": "checkbox", "id": "show_social", "label": "Show social links", "default": true }
      ]
    },
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Tell your story in a sentence or two.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in touch" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>New arrivals and quiet offers. No noise.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Subscribe" }
      ]
    },
    {
      "type": "contact",
      "name": "Contact",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Contact" },
        { "type": "text", "id": "phone", "label": "Phone" },
        { "type": "text", "id": "email", "label": "Email" },
        { "type": "text", "id": "address", "label": "Address" },
        { "type": "text", "id": "hours", "label": "Opening hours" }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "range", "id": "image_width", "min": 60, "max": 400, "step": 10, "unit": "px", "label": "Image width", "default": 180 },
        { "type": "richtext", "id": "text", "label": "Text" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "brand" },
      { "type": "menu" },
      { "type": "text" },
      { "type": "newsletter" }
    ]
  },
  "enabled_on": { "groups": ["footer"] }
}
{% endschema %}
