{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
  <div class="section">
    <div class="page-width{% if section.settings.narrow %} page-width--narrow{% endif %}">
      {%- render 'heading',
        text: section.settings.heading,
        tag: 'h2',
        size: section.settings.heading_size,
        ink: section.settings.ink_heading
      -%}
      {%- if section.settings.text != blank -%}
        <div class="rte text-muted">{{ section.settings.text }}</div>
      {%- endif -%}

      {%- assign contact_form_id = 'ContactForm-' | append: section.id -%}
      {%- form 'contact', class: 'contact-form', id: contact_form_id -%}
        {%- if form.posted_successfully? -%}
          <p class="form-status form-status--success" tabindex="-1" autofocus>
            {% render 'icon', icon: 'check-circle' %}
            <span>{{ 'templates.contact.form.post_success' | t }}</span>
          </p>
        {%- elsif form.errors -%}
          <div class="form-status form-status--error" tabindex="-1" autofocus>
            <p>{{ 'templates.contact.form.error_heading' | t }}</p>
            <ul>
              {%- for field in form.errors -%}
                <li>{{ form.errors.translated_fields[field] }} {{ form.errors.messages[field] }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        <div class="contact-form__grid">
          <div class="field">
            <label class="field__label" for="ContactName-{{ section.id }}">{{ 'templates.contact.form.name' | t }}</label>
            <input
              id="ContactName-{{ section.id }}"
              type="text"
              name="contact[{{ 'templates.contact.form.name' | t }}]"
              autocomplete="name"
              value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
            >
          </div>

          <div class="field">
            <label class="field__label" for="ContactEmail-{{ section.id }}">{{ 'templates.contact.form.email' | t }}</label>
            <input
              id="ContactEmail-{{ section.id }}"
              type="email"
              name="contact[email]"
              autocomplete="email"
              required
              value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
            >
          </div>

          {%- if section.settings.show_phone -%}
            <div class="field">
              <label class="field__label" for="ContactPhone-{{ section.id }}">{{ 'templates.contact.form.phone' | t }}</label>
              <input
                id="ContactPhone-{{ section.id }}"
                type="tel"
                name="contact[{{ 'templates.contact.form.phone' | t }}]"
                autocomplete="tel"
                value="{% if customer %}{{ customer.phone }}{% endif %}"
              >
            </div>
          {%- endif -%}

          {%- if section.settings.show_subject -%}
            <div class="field">
              <label class="field__label" for="ContactSubject-{{ section.id }}">{{ 'templates.contact.form.subject' | t }}</label>
              <input id="ContactSubject-{{ section.id }}" type="text" name="contact[{{ 'templates.contact.form.subject' | t }}]">
            </div>
          {%- endif -%}
        </div>

        <div class="field">
          <label class="field__label" for="ContactBody-{{ section.id }}">{{ 'templates.contact.form.message' | t }}</label>
          <textarea id="ContactBody-{{ section.id }}" name="contact[body]" rows="6" required>{{ form.body }}</textarea>
        </div>

        <button type="submit" class="button">{{ 'templates.contact.form.send' | t }}</button>
      {%- endform -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "tag": "section",
  "class": "section-contact-form",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "דברו איתנו"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h3",
          "label": "Small"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "ink_heading",
      "label": "Underline the last word with the ink accent",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>אנחנו עונים לכל הודעה, בדרך כלל תוך יום עסקים.</p>"
    },
    {
      "type": "checkbox",
      "id": "narrow",
      "label": "Use the narrow reading width",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_phone",
      "label": "Ask for a phone number",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_subject",
      "label": "Ask for a subject",
      "default": false
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
