{%- liquid
  assign variant = product.selected_or_first_available_variant
  assign has_sticky = false
  if settings.product_sticky_atc
    assign has_sticky = true
  endif
-%}

{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
  #shopify-section-{{ section.id }} {
    --product-media-width: {{ section.settings.media_width }}%;
  }
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
  <div class="section">
    <div class="page-width">
      <div class="product-layout product-layout--{{ section.settings.media_position }}">
        <div class="product-layout__media{% if settings.product_sticky_column %} product-layout__media--scroll{% endif %}">
          {%- render 'product-gallery', product: product -%}
        </div>

        <div class="product-layout__info{% if settings.product_sticky_column %} product-layout__info--sticky{% endif %}">
          <div class="product-info" data-product-info data-product-id="{{ product.id }}" data-product-handle="{{ product.handle }}">
            {%- for block in section.blocks -%}
              {%- render 'product-block', block: block, product: product, context: 'main' -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

{%- if has_sticky -%}
  <sticky-atc
    class="sticky-atc sticky-atc--{{ settings.product_sticky_atc_position }}"
    data-sticky-atc
    hidden
  >
    <div class="page-width sticky-atc__inner">
      <div class="sticky-atc__product">
        {%- if product.featured_media -%}
          <div class="frame frame--soft" data-ratio="square">
            {%- render 'responsive-image',
              image: product.featured_media.preview_image,
              widths: '60,90,120,180',
              sizes: '52px',
              max_width: 180
            -%}
          </div>
        {%- endif -%}
        <div class="sticky-atc__text">
          <span class="sticky-atc__title text-small">{{ product.title }}</span>
          {%- render 'price', target: variant, class: 'price--small' -%}
        </div>
      </div>

      <div class="sticky-atc__actions">
        {%- if product.variants.size > 1 -%}
          <label class="visually-hidden" for="sticky-variant-{{ section.id }}">
            {{- 'products.product.quick_view' | t -}}
          </label>
          <select id="sticky-variant-{{ section.id }}" class="sticky-atc__select" data-sticky-variant>
            {%- for option_variant in product.variants -%}
              <option
                value="{{ option_variant.id }}"
                {% if option_variant.id == variant.id %}selected{% endif %}
                {% unless option_variant.available %}disabled{% endunless %}
              >
                {{ option_variant.title }} — {{ option_variant.price | money }}
              </option>
            {%- endfor -%}
          </select>
        {%- endif -%}
        <button class="button" type="button" data-sticky-add {% unless product.available %}disabled{% endunless %}>
          {%- if product.available -%}
            {{ 'products.product.add_to_cart' | t }}
          {%- else -%}
            {{ 'products.product.sold_out' | t }}
          {%- endif -%}
        </button>
      </div>
    </div>
  </sticky-atc>
{%- endif -%}

{%- if settings.recently_viewed_enabled -%}
  <script type="application/json" data-recently-viewed-product>
    {{ product.handle | json }}
  </script>
{%- endif -%}

