{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section section--ticker">
    {%- if section.blocks.size > 0 -%}
      <div
        class="ticker ticker--{{ section.settings.direction }}"
        data-marquee
        data-speed="{{ section.settings.speed }}"
        aria-label="{{ section.settings.label | escape }}"
      >
        <div class="ticker__track" data-marquee-track>
          {%- for block in section.blocks -%}
            <span class="ticker__item" style="--ticker-size: {{ section.settings.text_size }};" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{%- endif -%}
                {%- if block.settings.icon != 'none' -%}
                  {% render 'icon', icon: block.settings.icon %}
                {%- endif -%}
                <span>{{ block.settings.text }}</span>
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </span>
            {%- if section.settings.separator != blank -%}
              <span class="ticker__separator" aria-hidden="true">{{ section.settings.separator }}</span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Scrolling text",
  "tag": "section",
  "class": "section-ticker",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-4"
    },
    {
      "type": "text",
      "id": "label",
      "label": "Accessible label",
      "default": "הודעות"
    },
    {
      "type": "select",
      "id": "direction",
      "label": "Direction",
      "options": [
        {
          "value": "horizontal",
          "label": "Sideways"
        },
        {
          "value": "vertical",
          "label": "Upwards"
        }
      ],
      "default": "horizontal"
    },
    {
      "type": "range",
      "id": "speed",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "s",
      "label": "Seconds per loop",
      "default": 30
    },
    {
      "type": "range",
      "id": "text_size",
      "min": 1,
      "max": 6,
      "step": 1,
      "unit": "rem",
      "label": "Text size",
      "default": 2
    },
    {
      "type": "text",
      "id": "separator",
      "label": "Separator",
      "default": "✦"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 16
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 16
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "משלוח חינם מעל 250 ₪"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "truck",
              "label": "Delivery"
            },
            {
              "value": "fire",
              "label": "Hot"
            }
          ],
          "default": "none"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Scrolling text",
      "blocks": [
        {
          "type": "item"
        },
        {
          "type": "item"
        },
        {
          "type": "item"
        }
      ]
    }
  ]
}
{% endschema %}
