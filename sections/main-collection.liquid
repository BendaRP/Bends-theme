{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
  #shopify-section-{{ section.id }} {
    --grid-min: {{ 1200 | divided_by: section.settings.columns_desktop }}px;
    --grid-mobile: {{ section.settings.columns_mobile }};
  }
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}">
  <div class="section">
    <div class="page-width">
      {%- if section.settings.show_breadcrumbs -%}
        {%- render 'breadcrumbs' -%}
      {%- endif -%}

      {%- if section.settings.show_banner -%}
        <div class="collection-banner collection-banner--{{ section.settings.banner_style }}">
          {%- if collection.image and section.settings.banner_style != 'text' -%}
            <div class="frame collection-banner__media" data-ratio="{{ section.settings.banner_ratio }}">
              {%- render 'responsive-image',
                image: collection.image,
                sizes: '100vw',
                priority: true
              -%}
            </div>
          {%- endif -%}
          <div class="collection-banner__text">
            {%- render 'heading', text: collection.title, tag: 'h1', size: 'h1', ink: section.settings.ink_heading -%}
            {%- if collection.description != blank and section.settings.show_description -%}
              <div class="rte text-muted collection-banner__description">{{ collection.description }}</div>
            {%- endif -%}
            <p class="text-tiny text-muted">
              {{- 'products.facets.product_count' | t: count: collection.products_count -}}
            </p>
          </div>
        </div>
      {%- endif -%}

      {%- paginate collection.products by section.settings.products_per_page -%}
        <div class="collection-layout collection-layout--{{ section.settings.filter_layout }}">
          {%- if section.settings.show_filters -%}
            <button
              class="button button--secondary button--small collection-layout__filter-toggle"
              type="button"
              data-facet-toggle
              aria-expanded="false"
              aria-controls="FacetPanel-{{ section.id }}"
            >
              {% render 'icon', icon: 'filter' %}
              <span>{{ 'products.facets.filter_and_sort' | t }}</span>
            </button>

            <aside class="collection-layout__aside" id="FacetPanel-{{ section.id }}" data-facet-panel>
              {%- render 'facets', results: collection, context: 'collection', layout: section.settings.filter_layout -%}
            </aside>
          {%- endif -%}

          <div class="collection-layout__main" id="ProductGrid" data-collection-grid>
            {%- if collection.products.size > 0 -%}
              <div class="grid grid--auto{% if section.settings.offset_grid %} grid--offset{% endif %}" data-product-grid>
                {%- for product in collection.products -%}
                  {%- render 'product-card',
                    product: product,
                    index: forloop.index0,
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 50vw'
                  -%}
                {%- endfor -%}
              </div>

              {%- render 'pagination', paginate: paginate, anchor: '#ProductGrid' -%}
            {%- else -%}
              <div class="collection-empty">
                <p class="h4">{{ 'collections.general.no_matches' | t }}</p>
                <a class="button button--secondary" href="{{ collection.url }}">
                  {{ 'products.facets.clear_all' | t }}
                </a>
              </div>
            {%- endif -%}
          </div>
        </div>
      {%- endpaginate -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Collection",
  "tag": "section",
  "class": "section-main-collection",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-1" },
    { "type": "checkbox", "id": "show_breadcrumbs", "label": "Show breadcrumbs", "default": true },
    { "type": "header", "content": "Banner" },
    { "type": "checkbox", "id": "show_banner", "label": "Show the collection banner", "default": true },
    {
      "type": "select",
      "id": "banner_style",
      "label": "Banner style",
      "options": [
        { "value": "text", "label": "Text only" },
        { "value": "stacked", "label": "Image above the text" },
        { "value": "overlay", "label": "Text over the image" }
      ],
      "default": "text"
    },
    {
      "type": "select",
      "id": "banner_ratio",
      "label": "Banner ratio",
      "options": [
        { "value": "wide", "label": "Wide" },
        { "value": "landscape", "label": "Landscape" },
        { "value": "square", "label": "Square" }
      ],
      "default": "wide"
    },
    { "type": "checkbox", "id": "show_description", "label": "Show the collection description", "default": true },
    { "type": "checkbox", "id": "ink_heading", "label": "Underline the last word with the ink accent", "default": true },
    { "type": "header", "content": "Grid" },
    { "type": "range", "id": "products_per_page", "min": 8, "max": 48, "step": 4, "label": "Products per page", "default": 24 },
    { "type": "range", "id": "columns_desktop", "min": 2, "max": 5, "step": 1, "label": "Columns on desktop", "default": 4 },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    { "type": "checkbox", "id": "offset_grid", "label": "Stagger alternate cards", "default": true, "info": "The editorial offset that stops a grid reading like a spreadsheet." },
    { "type": "header", "content": "Filtering" },
    { "type": "checkbox", "id": "show_filters", "label": "Show filters", "default": true, "info": "Set up which filters appear under Search and discovery in your admin." },
    {
      "type": "select",
      "id": "filter_layout",
      "label": "Filter layout",
      "options": [
        { "value": "sidebar", "label": "Sidebar" },
        { "value": "drawer", "label": "Drawer" },
        { "value": "inline", "label": "Along the top" }
      ],
      "default": "sidebar"
    },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Top padding", "default": 32 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 160, "step": 4, "unit": "px", "label": "Bottom padding", "default": 64 }
  ]
}
{% endschema %}
