{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    <div class="{{ section.settings.width }}">
      {%- render 'section-header', s: section.settings -%}

      {%- if section.blocks.size > 0 -%}
        <ol class="timeline timeline--{{ section.settings.layout }}">
          {%- for block in section.blocks -%}
            <li
              class="timeline__step"
              data-reveal
              style="--reveal-delay: calc(var(--stagger) * {{ forloop.index0 }});"
              {{ block.shopify_attributes }}
            >
              <span class="timeline__marker" aria-hidden="true">
                {%- if block.settings.icon != 'none' -%}
                  {% render 'icon', icon: block.settings.icon %}
                {%- else -%}
                  <span class="timeline__dot"></span>
                {%- endif -%}
              </span>
              <div class="timeline__body">
                {%- if block.settings.label != blank -%}
                  <span class="eyebrow">{{ block.settings.label }}</span>
                {%- endif -%}
                {%- if block.settings.heading != blank -%}
                  <h3 class="timeline__heading h5">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte text-small text-muted">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.image != blank -%}
                  <div class="frame frame--soft timeline__image" data-ratio="landscape">
                    {%- render 'responsive-image', image: block.settings.image, sizes: '(min-width: 750px) 320px, 80vw', max_width: 900 -%}
                  </div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ol>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Timeline",
  "tag": "section",
  "class": "section-timeline",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Colour scheme",
      "default": "scheme-1"
    },
    {
      "type": "select",
      "id": "width",
      "label": "Width",
      "options": [
        {
          "value": "page-width",
          "label": "Page width"
        },
        {
          "value": "page-width page-width--narrow",
          "label": "Narrow"
        },
        {
          "value": "page-width page-width--wide",
          "label": "Wide"
        },
        {
          "value": "page-width page-width--full",
          "label": "Full bleed"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "vertical",
          "label": "Vertical"
        },
        {
          "value": "horizontal",
          "label": "Horizontal"
        },
        {
          "value": "alternating",
          "label": "Alternating sides"
        }
      ],
      "default": "vertical"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "הסיפור שלנו"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "איך הגענו לכאן"
    },
    {
      "type": "select",
      "id": "heading_size",
      "label": "Heading size",
      "options": [
        {
          "value": "h4",
          "label": "Extra small"
        },
        {
          "value": "h3",
          "label": "Small"
        },
        {
          "value": "h2",
          "label": "Medium"
        },
        {
          "value": "h1",
          "label": "Large"
        },
        {
          "value": "h0",
          "label": "Display"
        }
      ],
      "default": "h2"
    },
    {
      "type": "checkbox",
      "id": "ink_heading",
      "label": "Underline the last word with the ink accent",
      "default": true
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": ""
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Alignment",
      "options": [
        {
          "value": "start",
          "label": "Start of line"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "end",
          "label": "End of line"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 56
    },
    {
      "type": "header",
      "content": "Visibility"
    },
    {
      "type": "checkbox",
      "id": "hide_on_mobile",
      "label": "Hide on mobile",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "hide_on_desktop",
      "label": "Hide on desktop",
      "default": false
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "award",
              "label": "Award"
            },
            {
              "value": "store",
              "label": "Store"
            },
            {
              "value": "globe",
              "label": "Worldwide"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "package",
              "label": "Package"
            },
            {
              "value": "heart",
              "label": "Heart"
            }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "2019"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "מאה ההזמנות הראשונות"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>נארזו על שולחן המטבח, נשלחו מהדואר בפינה.</p>"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Timeline",
      "blocks": [
        {
          "type": "step"
        },
        {
          "type": "step"
        },
        {
          "type": "step"
        }
      ]
    }
  ]
}
{% endschema %}
