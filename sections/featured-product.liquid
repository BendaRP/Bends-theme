        {
          "value": "carousel",
          "label": "Carousel"
        },
        {
          "value": "stacked",
          "label": "Stacked"
        }
      ],
      "default": "thumbs_below"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 56
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 200,
