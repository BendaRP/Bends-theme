{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    <div class="{{ section.settings.width }}">
      {%- liquid
        assign featured = section.settings.product
      -%}
      {%- if featured != blank -%}
        <div class="featured-product featured-product--media-{{ section.settings.media_position }}">
          <div class="featured-product__media" data-reveal>
            {%- render 'product-gallery', product: featured, layout: section.settings.gallery_layout -%}
          </div>

          <div class="featured-product__info" data-reveal>
            {%- for block in section.blocks -%}
              {%- render 'product-block', block: block, product: featured, context: 'featured' -%}
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        <div class="featured-product featured-product--placeholder">
          <div class="frame" data-ratio="portrait">
            <div class="media-placeholder">{{ 'product-1' | placeholder_svg_tag }}</div>
          </div>
          <div class="featured-product__info">
            <p class="h3">{{ 'onboarding.product_title' | t }}</p>
            <p class="text-muted">{{ 'onboarding.no_content' | t }}</p>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured product",
  "tag": "section",
  "class": "section-featured-product",
  "settings": [
    {
      "type": "color_scheme",
