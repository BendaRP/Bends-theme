    },
    {
      "type": "product",
      "id": "product",
      "label": "Product"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Gallery position",
      "options": [
        {
          "value": "start",
          "label": "Start of line"
        },
        {
          "value": "end",
          "label": "End of line"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "gallery_layout",
