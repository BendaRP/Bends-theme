{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

<div class="section-wrapper color-{{ section.settings.color_scheme }}{% if section.settings.hide_on_mobile %} hide-mobile{% endif %}{% if section.settings.hide_on_desktop %} hide-desktop{% endif %}">
  <div class="section">
    <div class="{{ section.settings.width }}">
      {%- render 'section-header', s: section.settings -%}

      {%- if section.blocks.size > 0 -%}
        <div
          class="grid grid--{{ section.settings.columns }} multicolumn multicolumn--{{ section.settings.card_style }}{% if section.settings.offset_grid %} grid--offset{% endif %}"
          style="--grid-mobile: {{ section.settings.columns_mobile }};"
        >
          {%- for block in section.blocks -%}
            <div
              class="multicolumn__item text-{{ section.settings.item_alignment }}"
              data-reveal
              style="--reveal-delay: calc(var(--stagger) * {{ forloop.index0 }});"
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.image != blank -%}
                <div class="frame multicolumn__media" data-ratio="{{ section.settings.image_ratio }}">
                  {%- render 'responsive-image', image: block.settings.image, sizes: '(min-width: 990px) 25vw, 80vw' -%}
                </div>
              {%- elsif block.settings.icon != 'none' -%}
                {% render 'icon', icon: block.settings.icon, class: 'multicolumn__icon icon--xl' %}
              {%- endif -%}

              <div class="multicolumn__body">
                {%- if block.settings.heading != blank -%}
                  <h3 class="multicolumn__heading h5">{{ block.settings.heading }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="rte text-small text-muted">{{ block.settings.text }}</div>
                {%- endif -%}
                {%- if block.settings.link_label != blank -%}
                  <a class="link text-small" href="{{ block.settings.link | default: '#' }}">
                    {{ block.settings.link_label }}
                    {% render 'icon', icon: 'arrow-right' %}
                  </a>
                {%- endif -%}
              </div>
            </div>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

