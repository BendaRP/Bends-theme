{%- style -%}
  {%- render 'section-styles', section_id: section.id, s: section.settings -%}
{%- endstyle -%}

{%- if section.blocks.size > 0 -%}
  <announcement-bar
    class="announcement-bar color-{{ section.settings.color_scheme }}"
    data-autorotate="{{ section.settings.autorotate }}"
    data-speed="{{ section.settings.autorotate_speed | times: 1000 }}"
  >
    <div class="section">
      <div class="page-width announcement-bar__inner">
        {%- if section.blocks.size > 1 -%}
          <button
            class="announcement-bar__arrow tap-target"
            type="button"
            data-announcement-prev
            aria-label="{{ 'sections.announcements.previous' | t }}"
          >
            {% render 'icon', icon: 'chevron-left' %}
          </button>
        {%- endif -%}

        <div
          class="announcement-bar__track"
          data-announcement-track
          role="region"
          aria-roledescription="{{ 'sections.announcements.carousel' | t }}"
          aria-label="{{ 'accessibility.announcement' | t }}"
        >
          {%- for block in section.blocks -%}
            <div
              class="announcement-bar__slide{% if forloop.first %} is-active{% endif %}"
              data-announcement-slide
              {% unless forloop.first %}aria-hidden="true"{% endunless %}
              {{ block.shopify_attributes }}
            >
              {%- if block.settings.link != blank -%}<a class="announcement-bar__link" href="{{ block.settings.link }}">{%- endif -%}
                {%- if block.settings.icon != 'none' -%}
                  {% render 'icon', icon: block.settings.icon, class: 'announcement-bar__icon' %}
                {%- endif -%}
                <span class="announcement-bar__text">{{ block.settings.text }}</span>
              {%- if block.settings.link != blank -%}</a>{%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if section.blocks.size > 1 -%}
          <button
            class="announcement-bar__arrow tap-target"
            type="button"
            data-announcement-next
            aria-label="{{ 'sections.announcements.next' | t }}"
          >
            {% render 'icon', icon: 'chevron-right' %}
          </button>
        {%- endif -%}
      </div>
    </div>
  </announcement-bar>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "tag": "section",
  "class": "section-announcement",
  "settings": [
    { "type": "color_scheme", "id": "color_scheme", "label": "Colour scheme", "default": "scheme-3" },
    { "type": "checkbox", "id": "autorotate", "label": "Rotate automatically", "default": true },
    { "type": "range", "id": "autorotate_speed", "min": 3, "max": 15, "step": 1, "unit": "s", "label": "Seconds per announcement", "default": 5 },
    { "type": "header", "content": "Spacing" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Top padding", "default": 10 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 40, "step": 2, "unit": "px", "label": "Bottom padding", "default": 10 }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "Free shipping over 250" },
        { "type": "url", "id": "link", "label": "Link" },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "truck", "label": "Delivery" },
            { "value": "return", "label": "Returns" },
            { "value": "shield-check", "label": "Secure" },
            { "value": "gift", "label": "Gift" },
            { "value": "percent", "label": "Discount" },
            { "value": "fire", "label": "Hot" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "leaf", "label": "Sustainable" },
            { "value": "clock", "label": "Time" },
            { "value": "bolt", "label": "Fast" }
          ],
          "default": "truck"
        }
      ]
    }
  ],
  "default": {
    "blocks": [{ "type": "announcement" }]
  },
  "enabled_on": { "groups": ["header", "footer"] }
}
{% endschema %}
